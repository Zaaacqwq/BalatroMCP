{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "balatro.action.schema.json",
  "title": "ActionRequest",
  "type": "object",
  "required": ["action_type"],
  "properties": {
    "action_type": {
      "type": "string",
      "enum": [
        "select_card",
        "deselect_card",
        "play_hand",
        "discard_selected",
        "buy_item",
        "reroll_shop",
        "sell_joker",
        "use_consumable",
        "choose_option",
        "continue",
        "skip",
        "end_turn"
      ]
    },
    "params": {"type": "object"},
    "idempotency_key": {"type": "string"}
  },
  "additionalProperties": false
}
